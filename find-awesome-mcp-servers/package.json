{
  "name": "find-awesome-mcp-servers",
  "version": "1.0.0",
  "private": true,
  "description": "Discovers and analyzes curated MCP index repositories",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm test && node --check ../site/app.js",
    "find": "npm run build --silent && node dist/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "octokit": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
